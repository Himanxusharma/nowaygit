# nowaygit configuration environment reference
# Note: Since this is a client-side Chrome Extension, these values are entered 
# interactively by the user in the Extension Settings UI rather than loaded from a server file.
# This file serves as a reference for the keys and URLs you will need to configure.

# --- Anthropic AI Settings ---
# Used client-side to generate AI commit messages & README files
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- GitHub Authentication (OAuth Device Flow) ---
# The Client ID for your GitHub OAuth App (default is pre-configured in the extension)
GITHUB_CLIENT_ID=Ov23liZ2Ym642n4jZ9aO

# --- GitLab Integration ---
# GitLab Personal Access Token (PAT) with `api` scope
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-...
# GitLab Host URL (leave blank for gitlab.com, or enter custom self-hosted URL)
GITLAB_HOST_URL=https://gitlab.example.com

# --- Bitbucket Integration ---
# Bitbucket App Password with repository read/write permissions
BITBUCKET_APP_PASSWORD=...
# Bitbucket Username connected to the account
BITBUCKET_USERNAME=my_bitbucket_user

# --- Vercel Deploy Hooks ---
# The deploy hook URL from your Vercel project settings (Git -> Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
