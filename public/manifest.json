{
  "manifest_version": 3,
  "name": "nowaygit — Push Claude.ai to GitHub",
  "short_name": "nowaygit",
  "version": "1.0.0",
  "description": "Push claude.ai code artifacts directly to GitHub repositories without leaving your chat.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "nowaygit"
  }
}
